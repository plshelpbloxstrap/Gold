local function SafeRestore(hrp)
    if State.OriginalData[hrp] then
        hrp.Size = State.OriginalData[hrp].Size
        hrp.Transparency = State.OriginalData[hrp].Transparency
        hrp.Color = State.OriginalData[hrp].Color
        State.OriginalData[hrp] = nil
    end
end

