        State.HitboxSize = num
        SizeBox.Text = tostring(num)
    else
        SizeBox.Text = tostring(State.HitboxSize)
    end
end)

local function ProcessHitbox()
    if not State.HitboxEnabled then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                if not State.OriginalData[hrp] then
                    State.OriginalData[hrp] = {
                        Size = hrp.Size,
                        Transparency = hrp.Transparency,
                        Color = hrp.Color
                    }
                end
                hrp.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
                hrp.Transparency = 0.8
                hrp.Color = Color3.fromRGB(120, 120, 120)
            end
        end
    end
end

local function ProcessTrigger()
    if not State.TriggerEnabled then 
        if State.HandExtender then
            State.HandExtender:Destroy()
            State.HandExtender = nil
        end
        return 
    end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    local tool = char:FindFirstChildOfClass("Tool")
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    
    if not myHrp or not tool or not rightHand then return end

    if not State.HandExtender or State.HandExtender.Parent ~= rightHand then
        if State.HandExtender then State.HandExtender:Destroy() end
        
        local ext = Instance.new("Part")
        ext.Name = "Hitbox"
        ext.Size = Vector3.new(rightHand.Size.X, rightHand.Size.Y, rightHand.Size.Z + 2.5)
        ext.Transparency = 1
        ext.CanCollide = false
        ext.CanQuery = false
        ext.CanTouch = false
        ext.Massless = true
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rightHand
        weld.Part1 = ext
        weld.Parent = ext
        
        ext.CFrame = rightHand.CFrame * CFrame.new(0, 0, -1.5)
        ext.Parent = rightHand
        State.HandExtender = ext
    else
        State.HandExtender.CFrame = rightHand.CFrame * CFrame.new(0, 0, -1.5)
    end

    local attackOrigin = State.HandExtender.Position

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (attackOrigin - targetHrp.Position).Magnitude
                local checkRange = State.HitboxEnabled and State.HitboxSize or 6
                
                if dist <= (checkRange / 2) + 3.5 then
                    if not State.AttackCooldowns[plr.UserId] then
                        State.AttackCooldowns[plr.UserId] = true
                        
                        pcall(function() tool:Activate() end)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        
                        task.delay(0.15, function()
                            if State.AttackCooldowns[plr.UserId] then
                                State.AttackCooldowns[plr.UserId] = nil
                            end
                        end)
                    end
                else
                    if State.AttackCooldowns[plr.UserId] then
                        State.AttackCooldowns[plr.UserId] = nil
                    end
                end
            end
        end
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if method == "FireServer" and self.Name == "GeneralHit" then
        if State.CritEnabled then
            local args = {...}
            if args[1] then
                return oldNamecall(self, args[1], true, unpack(args, 3))
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        ProcessHitbox()
        ProcessTrigger()
    end)
end)

task.spawn(function()
    while task.wait(1) do
        for hrp, _ in pairs(State.OriginalData) do
            local char = hrp.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                State.OriginalData[hrp] = nil
            end
        end
    end
end)
